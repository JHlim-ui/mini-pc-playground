# ================================
# Claude API (console.anthropic.com)
# ================================
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# KakaoTalk
# 1. developers.kakao.com > 내 애플리케이션 > 앱 생성
# 2. 앱 키 > REST API 키 복사
# 3. 카카오 로그인 > Redirect URI: http://localhost:5000/kakao/callback
# 4. python scripts/kakao_auth.py 실행해서 최초 토큰 발급
# ================================
KAKAO_REST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KAKAO_REDIRECT_URI=http://localhost:5000/kakao/callback

# ================================
# OpenWeatherMap (openweathermap.org - 무료)
# 가입 후 API Keys 메뉴에서 발급
# ================================
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# Microsoft (Azure 앱 등록 완료)
# ================================
MICROSOFT_CLIENT_ID=c5fa6daa-5904-45cf-bf5b-b56e6b178747
MICROSOFT_TENANT_ID=common
